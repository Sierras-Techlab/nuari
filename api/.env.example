PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/nuari?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/nuari?sslmode=require
# Two different random secrets, at least 32 bytes each. Required in production.
CSRF_SECRET=
RATE_LIMIT_SECRET=
BOOKING_SUBMISSION_SECRET=
# Increment version when rotating; keep prior secrets during submission retention, e.g. JSON {"1":"<secret>"}.
BOOKING_SUBMISSION_SECRET_VERSION=1
BOOKING_SUBMISSION_PREVIOUS_SECRETS=
# Dedicated key for public booking management links. Retain previous keys until tokens expire or are revoked.
MANAGEMENT_TOKEN_SECRET=
MANAGEMENT_TOKEN_SECRET_VERSION=1
MANAGEMENT_TOKEN_PREVIOUS_SECRETS=
RESEND_API_KEY=
EMAIL_FROM=
# Explicit ingress IP/CIDR list. Empty means socket IP only; never trust all proxies.
TRUSTED_PROXY_CIDRS=
# Tests never fall back to DATABASE_URL; isolated local test database only.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

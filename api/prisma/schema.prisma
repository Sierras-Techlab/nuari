generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  SERVICES
  COMMERCE
  HOSPITALITY
}

enum PlanCode {
  BASIC
  PRO
  BUSINESS
  TOURISM
}

enum OrganizationRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIALING
  EXPIRED
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ServicePricingType {
  FIXED
  FROM
  ON_REQUEST
}

enum StaffSelectionMode {
  CUSTOMER_CHOICE
  AUTO_ASSIGN
  NO_ASSIGNMENT
}

enum ServiceModality {
  IN_PERSON
}

model User {
  id                      String @id @default(uuid()) @db.Uuid
  name                    String
  email                   String @unique
  emailVerifiedAt         DateTime? @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  credential              UserCredential?
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  memberships             OrganizationMember[]
  trialGrant              TrialGrant?
  onboardingSubmissions   OnboardingSubmission[]
  sentInvitations         OrganizationInvitation[] @relation("InvitedByUser")
  auditLogs               OrganizationAuditLog[]
  staffProfiles           StaffMember[]
}

model UserCredential {
  userId            String @id @db.Uuid
  passwordHash      String
  version           Int @default(1)
  passwordChangedAt DateTime @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                   String @id @default(uuid()) @db.Uuid
  userId               String @db.Uuid
  tokenHash            String @unique @db.Char(64)
  credentialVersion    Int
  activeOrganizationId String? @db.Uuid
  createdAt            DateTime @db.Timestamptz(3)
  lastSeenAt           DateTime @db.Timestamptz(3)
  expiresAt            DateTime @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  tokenHash  String @unique @db.Char(64)
  createdAt  DateTime @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  tokenHash  String @unique @db.Char(64)
  createdAt  DateTime @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  scope           String
  keyHash         String @db.Char(64)
  windowStartedAt DateTime @db.Timestamptz(3)
  count           Int
  expiresAt       DateTime @db.Timestamptz(3)
  @@id([scope, keyHash, windowStartedAt])
  @@index([expiresAt])
}

model Organization {
  id                    String @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String @unique
  businessType          BusinessType
  description           String?
  email                 String?
  phone                 String?
  website               String?
  country               String?
  state                 String?
  city                  String?
  zip                   String?
  address               String?
  timezone              String @default("America/Argentina/Buenos_Aires")
  currency              String @default("ARS")
  logoUrl               String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  memberships           OrganizationMember[]
  selectedBySessions    Session[]
  subscription          Subscription?
  trialGrant            TrialGrant?
  onboardingSubmission  OnboardingSubmission?
  invitations           OrganizationInvitation[]
  auditLogs             OrganizationAuditLog[]
  customers             Customer[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  staffMembers           StaffMember[]
}

model OrganizationMember {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  organizationId String @db.Uuid
  role           OrganizationRole
  status         MembershipStatus
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([userId, organizationId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Subscription {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  planCode       PlanCode
  status         SubscriptionStatus
  trialStartedAt DateTime @db.Timestamptz(3)
  trialEndsAt    DateTime @db.Timestamptz(3)
  paidThrough    DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([status, trialEndsAt])
}

model TrialGrant {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @unique @db.Uuid
  organizationId String @unique @db.Uuid
  grantedAt      DateTime @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model OnboardingSubmission {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  key            String @db.Uuid
  requestHash    String @db.Char(64)
  organizationId String @unique @db.Uuid
  createdAt      DateTime @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([userId, key])
}

model OrganizationInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  email           String
  role            OrganizationRole
  tokenHash       String           @unique @db.Char(64)
  invitedByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime         @db.Timestamptz(3)
  acceptedAt      DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUser   User             @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  @@index([organizationId, email])
  @@index([expiresAt])
}

model OrganizationAuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String       @db.Uuid
  action         String
  targetId       String?
  metadata       String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  name            String       @db.VarChar(150)
  phone           String?      @db.VarChar(30)
  phoneNormalized String?      @db.VarChar(30)
  email           String?      @db.VarChar(254)
  notes           String?      @db.VarChar(4000)
  active          Boolean      @default(true)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, active, createdAt, id])
  @@index([organizationId, email])
  @@index([organizationId, phoneNormalized])
}

model ServiceCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(100)
  nameKey        String       @db.VarChar(100)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  services       Service[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@index([organizationId, active, sortOrder, id])
}

model Service {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  name               String             @db.VarChar(150)
  nameKey            String             @db.VarChar(150)
  description        String?            @db.VarChar(2000)
  durationMinutes    Int
  pricingType        ServicePricingType @default(ON_REQUEST)
  price              Decimal?           @db.Decimal(12, 2)
  currency           String             @db.VarChar(3)
  categoryId         String?            @db.Uuid
  active             Boolean            @default(true)
  sortOrder          Int                @default(0)
  staffSelectionMode StaffSelectionMode
  modality           ServiceModality    @default(IN_PERSON)
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category           ServiceCategory?   @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  staffLinks         StaffService[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
  @@index([organizationId, active, sortOrder, id])
  @@index([organizationId, categoryId, active])
}

model StaffMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(150)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(30)
  active         Boolean      @default(true)
  userId         String?      @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceLinks   StaffService[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId, active, name, id])
}

model StaffService {
  organizationId String      @db.Uuid
  staffMemberId  String      @db.Uuid
  serviceId      String      @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  staffMember    StaffMember @relation(fields: [organizationId, staffMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  service        Service     @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, staffMemberId, serviceId])
  @@index([organizationId, serviceId, staffMemberId])
}
